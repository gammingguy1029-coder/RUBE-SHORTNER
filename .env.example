NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
TOKEN_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Origin serving the ad frame HTML (the ads-origin/ folder, deployed separately).
# No trailing slash, e.g. https://euphonious-lily-07eaf6.netlify.app
# Must NOT be the same origin as the main site: the ad script reads
# document.cookie, which requires allow-same-origin on the iframe, and granting
# that to a same-origin frame would let it escape the sandbox entirely. When this
# is unset, AdFrame falls back to same-origin /ads/* with the strict sandbox —
# safe, but ads will not render.
NEXT_PUBLIC_ADS_ORIGIN=
